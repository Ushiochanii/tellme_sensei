# Copy this file to .env and fill in the provider key(s) you use.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Optional independent provider/model selections.
TEXT_AI_PROVIDER=deepseek
TEXT_AI_MODEL=deepseek-chat
VISION_AI_PROVIDER=deepseek
VISION_AI_MODEL=deepseek-v4-flash-vision-exp
# AI_REQUEST_TIMEOUT is provider-neutral; DEEPSEEK_TIMEOUT remains a legacy fallback.
AI_REQUEST_TIMEOUT=60
DEEPSEEK_TIMEOUT=60
OCR_LANGUAGE=japan
GLOBAL_SHORTCUT=Ctrl+Shift+A
VISION_GLOBAL_SHORTCUT=Ctrl+Shift+S
# Optional online OCR backend; default is local.
OCR_PROVIDER=local
GOOGLE_VISION_API_KEY=
ONLINE_OCR_TIMEOUT=15
